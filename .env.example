# Order It Up (OIU) — Environment Configuration
# Copy this file to .env and customize as needed.

# ==============================================================================
# LOCAL POS NETWORK & RUNTIME PORTS
# ==============================================================================
# Node execution mode: development, production, test
NODE_ENV=development

# Primary POS local Express API port (default: 3001)
PORT=3001

# Kitchen Display System (KDS) WebSocket port (default: 3002)
KDS_PORT=3002

# Waiter / Tableside ordering app port (default: 3003)
SERVER_APP_PORT=3003

# ==============================================================================
# SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
# JWT signing secret for staff sessions. If not provided, OIU generates a cryptographically
# secure 64-character random key on first launch.
# JWT_SECRET=your-64-character-random-hex-string

# Central SaaS operator API (disabled unless explicitly configured)
# Generate a strong random secret (at least 32 characters) and store it in your secret manager.
# OIU_ADMIN_JWT_SECRET=
# Configure only the operators you have created. Store bcrypt hashes, never plaintext passwords.
# Example shape (do not copy the placeholder hash):
# OIU_ADMIN_OPERATORS_JSON='[{"id":"operator-1","email":"admin@example.com","name":"Platform Administrator","role":"SUPER_ADMIN","passwordHash":"$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH"}]'

# Google Identity Services Web OAuth client ID (browser build setting)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# 32-byte master AES encryption key for local credentials and payload protection.
# ENCRYPTION_KEY=your-32-byte-encryption-key

# ==============================================================================
# CLOUD REPLICATION & DISASTER RECOVERY
# ==============================================================================
# First-party OIU Cloud API URL
# OIU_CLOUD_API_URL=https://api.orderitup.in

# MongoDB Atlas URI for real-time multi-tenant order and customer replication
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/oiu_production
# MONGODB_DB_NAME=oiu_production

# Amazon S3 for daily encrypted SQLite database snapshots
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=oiu-backups-production
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ==============================================================================
# COMMERCIAL SUBSCRIPTION & PAYMENT GATEWAY (INDIA)
# ==============================================================================
# Razorpay API credentials for automatic recurring subscription billing
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ==============================================================================
# OPENROUTER AI ENGINE (RESTAURANT COPILOT & SOMMELIER)
# ==============================================================================
# OpenRouter API key for LLM-powered dish sommelier, virtual waiter, and analytics
# OPENROUTER_API_KEY=sk-or-v1-...
# Default model (can be any free OpenRouter model, e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
