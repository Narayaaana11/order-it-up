# Order It Up (OIU) — Environment Configuration
# Copy this file to .env and customize as needed.

# ==============================================================================
# LOCAL POS NETWORK & RUNTIME PORTS
# ==============================================================================
# Node execution mode: development, production, test
NODE_ENV=development

# Primary POS local Express API port (default: 3001)
PORT=3001

# Kitchen Display System (KDS) WebSocket port (default: 3002)
KDS_PORT=3002

# Waiter / Tableside ordering app port (default: 3003)
SERVER_APP_PORT=3003

# ==============================================================================
# SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
# JWT signing secret for staff sessions. If not provided, OIU generates a cryptographically
# secure 64-character random key on first launch.
# JWT_SECRET=your-64-character-random-hex-string

# 32-byte master AES encryption key for local credentials and payload protection.
# ENCRYPTION_KEY=your-32-byte-encryption-key

# ==============================================================================
# CLOUD REPLICATION & DISASTER RECOVERY
# ==============================================================================
# First-party OIU Cloud API URL (Oracle Cloud unified backend)
# OIU_CLOUD_API_URL=https://api.orderitup.in
# NEXT_PUBLIC_OIU_CLOUD_API_URL=https://api.orderitup.in
# NEXT_PUBLIC_OIU_WS_URL=wss://api.orderitup.in

# MongoDB Atlas URI for real-time multi-tenant order and customer replication
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/oiu_production
# MONGODB_DB_NAME=oiu_production

# Amazon S3 for daily encrypted SQLite database snapshots
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=oiu-backups-production
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ==============================================================================
# COMMERCIAL SUBSCRIPTION & PAYMENT GATEWAY (INDIA)
# ==============================================================================
# Razorpay API credentials for automatic recurring subscription billing
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ==============================================================================
# OPENROUTER AI ENGINE (RESTAURANT COPILOT & SOMMELIER)
# ==============================================================================
# OpenRouter API key for LLM-powered dish sommelier, virtual waiter, and analytics
# OPENROUTER_API_KEY=sk-or-v1-...
# Default model (can be any free OpenRouter model, e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ==============================================================================
# FREE-TIER OBSERVABILITY, EMAIL, STORAGE & FEATURE FLAGS (ALL OPTIONAL)
# ==============================================================================
# Transactional Email (Resend or Brevo; falls back to SMTP/Mock when unset)
# RESEND_API_KEY=re_...
# BREVO_API_KEY=xkeysib-...
# OIU_EMAIL_FROM=Order It Up <noreply@orderitup.in>

# S3-Compatible Object Storage (Cloudflare R2 or Backblaze B2 for backups)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Error Tracking (Sentry, GlitchTip, or Bugsink DSN)
# OIU_SENTRY_DSN=https://<key>@<host>/<project_id>

# Heartbeat / Cron Monitoring (Healthchecks.io or Watchgoose)
# HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/<uuid>
# HEALTHCHECKS_CRON_URL=https://hc-ping.com/<uuid>

# Product Analytics (Aptabase for Desktop/Mobile, PostHog for Web)
# OIU_APTABASE_APP_KEY=A-US-0000000000
# OIU_POSTHOG_API_KEY=phc_...
# OIU_POSTHOG_HOST=https://us.i.posthog.com

# Feature Flags (GrowthBook client key)
# OIU_GROWTHBOOK_CLIENT_KEY=sdk-...

# LLM Tracing & Observability (Langfuse)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
