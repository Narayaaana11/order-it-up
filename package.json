    "build": {
        "appId": "com.orderitup.pos",
        "productName": "Order It Up",
        "npmRebuild": false,
        "icon": "assets/icon-512.png",
        "afterPack": "scripts/afterPack.js",
        "asar": true,
        "asarUnpack": "**/node_modules/better-sqlite3/**/*",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "node_modules/**/*",
            "!**/better-sqlite3/build/Release/test_extension.node"
        ],
        "publish": {
            "provider": "github",
            "channel": "latest"
        },
        "detectUpdateChannel": false,
        "generateUpdatesFilesForAllChannels": true,
        "extraResources": [
            {
                "from": "assets",
                "to": "assets"
            },
            {
                "from": "desktop-ui/out",
                "to": "frontend-out"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "appx",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "artifactName": "order-it-up-${version}-win-${arch}.${ext}"
        },
        "appx": {
            "applicationId": "OrderItUp",
            "backgroundColor": "#1e1e2e",
            "publisherDisplayName": "Order It Up",
            "identityName": "OrderItUp.POS",
            "publisher": "CN=OrderItUp",
            "displayName": "Order It Up",
            "languages": [
                "en-US"
            ]
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/icon.icns",
            "category": "public.app-category.business",
            "identity": null,
            "entitlements": "build/entitlements.plist",
            "entitlementsInherit": "build/entitlements.plist",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "notarize": false,
            "artifactName": "order-it-up-${version}-mac-${arch}.${ext}"
        },
        "mas": {
            "category": "public.app-category.business",
            "identity": null,
            "entitlements": "build/entitlements.mas.plist",
            "entitlementsInherit": "build/entitlements.mas.inherit.plist",
            "entitlementsLoginHelper": "build/entitlements.mas.loginhelper.plist",
            "hardenedRuntime": false,
            "gatekeeperAssess": false,
            "type": "distribution",
            "extendInfo": {
                "ITSAppUsesNonExemptEncryption": false
            },
            "target": [
                {
                    "target": "mas",
                    "arch": "universal"
                }
            ],
            "x64ArchFiles": "**/*.node"
        },
        "masDev": {
            "identity": null
        },
        "linux": {
            "synopsis": "Commercial offline-first POS & billing for restaurants and cafes",
            "description": "Order It Up is a commercial point-of-sale and restaurant billing management system for cafes, restaurants, cloud kitchens, and QSRs in India. Offline-first operations with cloud synchronization.",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "snap",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets",
            "category": "Office",
            "executableName": "order-it-up",
            "artifactName": "order-it-up-${version}-linux.${ext}",
            "extraFiles": [
                {
                    "from": "assets/com.orderitup.pos.metainfo.xml",
                    "to": "usr/share/metainfo/com.orderitup.pos.metainfo.xml"
                },
                {
                    "from": "assets/icons",
                    "to": "usr/share/icons"
                }
            ],
            "desktop": {
                "entry": {
                    "Name": "Order It Up",
                    "Comment": "Modern offline-first POS for cafes and restaurants",
                    "GenericName": "Point of Sale",
                    "Keywords": "pos;point of sale;restaurant;cafe;billing;invoice;",
                    "StartupWMClass": "order-it-up"
                }
            }
        },
        "appImage": {
            "artifactName": "order-it-up-${version}-linux.appimage"
        },
        "snapcraft": {
            "base": "core24",
            "core24": {
                "confinement": "strict",
                "useLXD": true,
                "extensions": [
                    "gnome"
                ],
                "stagePackages": [
                    "default"
                ],
                "plugs": [
                    "default",
                    "browser-support",
                    "cups-control",
                    "avahi-observe",
                    "avahi-control",
                    "raw-usb",
                    "removable-media",
                    "network-bind",
                    "screen-inhibit-control"
                ],
                "environment": {
                    "TMPDIR": "$XDG_RUNTIME_DIR"
                }
            }
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "allowScripts": {
        "electron-winstaller@5.4.0": true,
        "protobufjs@7.6.5": true,
        "@whiskeysockets/baileys@7.0.0-rc14": true
