# Public URLs for Order It Up Landing (Cloudflare Pages: orderitup.pages.dev)
# Set these in Cloudflare Pages -> Settings -> Environment variables (Production & Preview)

# Cloud API base URL (Cloudflare Worker or Oracle Unified Backend)
NEXT_PUBLIC_OIU_CLOUD_API_URL=https://api.orderitup.in

# Web App / Cloud Portal base URL (for Cloud POS & Pilot Invitation login redirects)
NEXT_PUBLIC_OIU_APP_URL=https://orderitup-app.pages.dev
NEXT_PUBLIC_OIU_CLOUD_PORTAL_URL=https://orderitup-app.pages.dev
