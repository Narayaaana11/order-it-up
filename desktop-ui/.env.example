# Public URLs for Order It Up Web App / Cloud Portal (Cloudflare Pages: orderitup-app.pages.dev)
# Set these in Cloudflare Pages -> Settings -> Environment variables (Production & Preview)

# Cloud API & WebSocket URLs
NEXT_PUBLIC_OIU_CLOUD_API_URL=https://api.orderitup.in
NEXT_PUBLIC_OIU_WS_URL=wss://api.orderitup.in

# Landing site URLs (for Sidebar Cloud Portal link & Pilot Access registration link)
NEXT_PUBLIC_OIU_LANDING_URL=https://orderitup.pages.dev
NEXT_PUBLIC_OIU_PILOT_ACCESS_URL=https://orderitup.pages.dev/request-access/
NEXT_PUBLIC_OIU_APP_URL=https://orderitup-app.pages.dev
