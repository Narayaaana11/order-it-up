{
  "name": "@orderitup/backend",
  "version": "1.0.0",
  "description": "Standalone unified Node.js 22 + SQLite WAL + WebSocket backend for Order It Up (Oracle Cloud)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node --transpile-only -P tsconfig.json src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "better-sqlite3": "^12.9.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5"
  }
}
